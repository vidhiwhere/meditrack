{
  "name": "meditrack-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "npm --prefix lumia-backend test",
    "test:api": "npm --prefix lumia-backend test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:smoke:live": "playwright test e2e/tests/05-live-smoke.spec.js",
    "test:report": "playwright show-report",
    "test:all": "npm --prefix lumia-backend test && playwright test",
    "test:seed": "npm --prefix lumia-backend run test:seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "pg": "^8.20.0",
    "redis": "^5.11.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  }
}
