    res.clearCookie('refreshToken');
    logger.info('User logged out successfully');
    res.json({
      message: 'Logout successful'
    });
  } catch (error) {
    logger.error('Logout error', {
      error: error.message
    });
    res.status(500).json({
      error: 'Logout failed'
    });
  }
};

