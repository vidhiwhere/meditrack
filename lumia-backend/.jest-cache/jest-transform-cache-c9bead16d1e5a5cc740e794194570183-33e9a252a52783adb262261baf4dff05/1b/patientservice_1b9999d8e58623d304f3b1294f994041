/**
 * Add symptom for patient
 */
const addSymptom = async (patientId, rawText) => {
  try {
    const analysis = await symptomAnalyzer.analyzeSymptom(rawText);
    const result = await db.query(`INSERT INTO symptoms (patient_id, raw_text, extracted_conditions, urgency, doctor_type_recommendation, risk_score, timeline_date)
       VALUES ($1, $2, $3, $4, $5, $6, NOW())
       RETURNING id, patient_id, raw_text, extracted_conditions, urgency, doctor_type_recommendation, risk_score, timeline_date`, [patientId, rawText, JSON.stringify(analysis.conditions), analysis.urgency, analysis.recommendedDoctorType, analysis.risk_score]);
