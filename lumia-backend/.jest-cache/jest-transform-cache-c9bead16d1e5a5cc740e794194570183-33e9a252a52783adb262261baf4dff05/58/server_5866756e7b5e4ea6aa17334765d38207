    // Test DB connection
    await db.query('SELECT NOW()');
    logger.info('✅ Database connected successfully');

    // Run migrations + seed in production
    if (process.env.DATABASE_URL) {
      const {
        runDeployInit
      } = require('./scripts/deploy-init');
      await runDeployInit();
    }
  } catch (err) {
    logger.error('Startup initialization failed', {
      error: err.message
    });
