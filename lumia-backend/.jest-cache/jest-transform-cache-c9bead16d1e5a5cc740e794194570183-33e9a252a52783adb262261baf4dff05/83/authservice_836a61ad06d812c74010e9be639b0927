    const {
      accessToken,
      refreshToken
    } = await tokenService.generateTokens(user.id, user.role);
    logger.info('User logged in successfully', {
      userId: user.id,
      email
    });
    return {
      user: {
        id: user.id,
        email: user.email,
        phone: user.phone,
        role: user.role
      },
      accessToken,
      refreshToken
    };
  } catch (error) {
    logger.error('Login error', {
      error: error.message
    });
    throw error;
  }
};

