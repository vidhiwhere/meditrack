const db = require('../../config/db');
const bcrypt = require('bcryptjs');
const tokenService = require('./tokenService');
const logger = require('../../utils/logger');

/**
 * Register a new user
 */
const registerUser = async (email, phone, password, role, firstName, lastName) => {
  try {
    // Check if user already exists
    const existingUser = await db.query('SELECT id FROM users WHERE email = $1 OR phone = $2', [email, phone]);
    if (existingUser.rows.length > 0) {
      throw new Error('User with this email or phone already exists');
    }

    // Hash password
    const salt = await bcrypt.genSalt(10);
    const passwordHash = await bcrypt.hash(password, salt);

    // Create user
    const userResult = await db.query(`INSERT INTO users (email, password_hash, phone, role, status, language, created_at, updated_at)
       VALUES ($1, $2, $3, $4, $5, $6, NOW(), NOW())
       RETURNING id, email, phone, role, status`, [email, passwordHash, phone, role, 'active', 'en']);
    const user = userResult.rows[0];

    // Always create a patient profile (for symptom tracking)
    await db.query(`INSERT INTO patients (user_id, first_name, last_name, created_at, updated_at)
       VALUES ($1, $2, $3, NOW(), NOW())`, [user.id, firstName || '', lastName || '']);

    // Create role-specific profile
    if (role === 'doctor') {
      // Doctor also gets a doctor profile
      await db.query(`INSERT INTO doctors (user_id, first_name, last_name, mci_registration_number, mci_verification_status, verification_status, specializations, created_at, updated_at)
         VALUES ($1, $2, $3, $4, 'verified', 'APPROVED', ARRAY['General Physician'], NOW(), NOW())`, [user.id, firstName || '', lastName || '', 'temp_' + user.id]);
    }
    logger.info('User registered successfully', {
      userId: user.id,
      email,
      role
    });
    return {
      id: user.id,
      email: user.email,
      phone: user.phone,
      role: user.role
    };
  } catch (error) {
    logger.error('Registration error', {
      error: error.message
    });
    throw error;
  }
};

/**
 * Login user
 */
